<mxGraphModel grid="0" page="1" pageWidth="560" pageHeight="700" background="#FFFFFF" adaptiveColors="none"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="从固定目标到隐式任务约束" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#183247;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="24" y="16" width="512" height="47.849999999999994" /></mxCell><mxCell id="3" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFF5F3;strokeColor=#EFD5D0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="24" y="76" width="512" height="151" /></mxCell><mxCell id="4" value="完整位姿：六维误差全部归零" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#A84440;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="92" width="474" height="39.599999999999994" /></mxCell><mxCell id="5" value="e(q) = Log₆(T(q)⁻¹T*) = 0" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=DejaVu Sans;fontSize=25;fontColor=#A84440;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="136" width="474" height="41.25" /></mxCell><mxCell id="6" value="位置与姿态同时固定，关节受限时可能停滞" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#647688;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="183" width="474" height="29.7" /></mxCell><mxCell id="7" value="↓" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#397397;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="245" y="233" width="70" height="47.849999999999994" /></mxCell><mxCell id="8